# Postgres (read by docker-compose.yml)
POSTGRES_USER=crewbase
POSTGRES_PASSWORD=change-me
POSTGRES_DB=crewbase

# Prisma (must match the three values above)
DATABASE_URL="postgresql://crewbase:change-me@localhost:5432/crewbase?schema=public"

JWT_SECRET="jwt-secret-key-min-32-chars"

# pgAdmin (optional, defaults are used if unset)
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=change-me